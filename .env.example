GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3010"

# Supabase project settings.
# Run supabase/schema.sql in Supabase SQL Editor first.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="portfolio-media"

# Tencent Cloud COS / ASR.
# ASR can reuse the COS SecretId/SecretKey if the sub-account has ASR permissions.
TENCENT_COS_SECRET_ID="your-tencent-secret-id"
TENCENT_COS_SECRET_KEY="your-tencent-secret-key"
TENCENT_COS_BUCKET="your-bucket-appid"
TENCENT_COS_REGION="ap-guangzhou"
TENCENT_COS_PUBLIC_BASE_URL="https://your-bucket-appid.cos.ap-guangzhou.myqcloud.com"
TENCENT_ASR_SECRET_ID=""
TENCENT_ASR_SECRET_KEY=""
TENCENT_ASR_REGION="ap-guangzhou"
TENCENT_ASR_ENGINE="16k_zh"

# Admin dashboard auth.
# Visit /admin and log in with this phone and password.
ADMIN_PHONE="18755571310"
ADMIN_PASSWORD="change-this-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

PORT=3010
