GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3010"
# 本地开发默认不上报统计；仅在专门验收埋点时临时设为 true。
VITE_ENABLE_ANALYTICS="false"

# Supabase project settings.
# Run supabase/schema.sql in Supabase SQL Editor first.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="portfolio-media"

# Tencent Cloud COS / ASR.
# ASR can reuse the COS SecretId/SecretKey if the sub-account has ASR permissions.
TENCENT_COS_SECRET_ID="your-tencent-secret-id"
TENCENT_COS_SECRET_KEY="your-tencent-secret-key"
TENCENT_COS_BUCKET="your-bucket-appid"
TENCENT_COS_REGION="ap-guangzhou"
TENCENT_COS_PUBLIC_BASE_URL="https://your-bucket-appid.cos.ap-guangzhou.myqcloud.com"
TENCENT_ASR_SECRET_ID=""
TENCENT_ASR_SECRET_KEY=""
TENCENT_ASR_REGION="ap-guangzhou"
TENCENT_ASR_ENGINE="16k_zh"

# Admin dashboard auth.
# Visit /admin and log in with this phone and password.
ADMIN_PHONE="18755571310"
ADMIN_PASSWORD="change-this-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

PORT=3010

# 柴犬小助手（Dify「聊天助手」或 Chatflow 应用的 API Key，只在服务端使用）。
# 自部署填 https://你的域名/v1；不填 Key 时线上不显示小助手。
DIFY_API_BASE="https://api.dify.ai/v1"
DIFY_API_KEY=""
DIFY_RATE_PER_MINUTE=8
DIFY_RATE_PER_DAY=80
# 每位匿名访客的长期记忆保留天数；设为 0 可关闭长期记忆。
DIFY_MEMORY_RETENTION_DAYS=180

# 万创核心：服务凭证和平台 Cookie 在管理员后台填写，不写入前端配置。
# 不单独设置 TOOL_SETTINGS_SECRET 时使用 ADMIN_SESSION_SECRET，至少 32 位。
# TOOL_SETTINGS_SECRET="replace-with-a-random-secret-at-least-32-characters"
# TOOL_SETTINGS_FILE=".private/wanchuang-settings.enc"
# WANCHUANG_DATA_DIR=".private/wanchuang-jobs"
# WANCHUANG_AUDIT_DIR=".private/wanchuang-audit"
# 全站识别连接数（1–3），需匹配云服务账号授权；与后台任务并发分开。
WANCHUANG_SPEECH_CONCURRENCY=2
# Windows 自动安装时从运行依赖清单读取路径；仅手工安装时指定实际路径。
# WANCHUANG_YTDLP="/absolute/path/to/yt-dlp"
# WANCHUANG_FFMPEG="/absolute/path/to/ffmpeg"
# WANCHUANG_BROWSER="/absolute/path/to/chromium"
